# RPC endpoints (server-side only — never expose private keys or restricted URLs to the client)
#
# Use any EVM-compatible JSON-RPC HTTPS endpoint.
# Free public options for local development:
#   ETHEREUM_RPC_URL=https://ethereum.publicnode.com
#   BASE_RPC_URL=https://mainnet.base.org
#   ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
#   POLYGON_RPC_URL=https://polygon-bor.publicnode.com
#   BSC_RPC_URL=https://bsc-dataseed.binance.org
#   OPTIMISM_RPC_URL=https://mainnet.optimism.io
#   AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
#
# For production, prefer a dedicated provider (Alchemy, Infura, QuickNode, etc.).

ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=
OPTIMISM_RPC_URL=
AVALANCHE_RPC_URL=

# Canonical site URL for SEO metadata (defaults to https://tx.tomnitive.com)
NEXT_PUBLIC_SITE_URL=https://tx.tomnitive.com

# Internal QA page at /internal/qa (404 unless enabled).
# Recommended: true on Vercel Preview, false/unset in Production.
ENABLE_INTERNAL_QA=

# Optional: override homepage example-gallery transaction hashes
# NEXT_PUBLIC_EXAMPLE_ETHEREUM_TX=0x...
# NEXT_PUBLIC_EXAMPLE_BASE_TX=0x...
# NEXT_PUBLIC_EXAMPLE_ARBITRUM_TX=0x...
# NEXT_PUBLIC_EXAMPLE_POLYGON_TX=0x...
# NEXT_PUBLIC_EXAMPLE_BSC_TX=0x...
# NEXT_PUBLIC_EXAMPLE_OPTIMISM_TX=0x...
# NEXT_PUBLIC_EXAMPLE_AVALANCHE_TX=0x...
